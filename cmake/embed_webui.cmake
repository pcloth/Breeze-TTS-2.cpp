# Numeric bytes avoid MSVC's 64 KiB string-literal limit; keep content exact.
file(WRITE "${OUT_HEADER}" "// generated, do not edit\n#pragma once\nnamespace breeze_webui {\n")
foreach(pair "index_html|index.html" "style_css|style.css" "app_js|app.js")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 path)
    file(READ "${WEBUI_DIR}/${path}" hex HEX)
    string(REGEX REPLACE "(..)" "(char)0x\\1," bytes "${hex}")
    file(APPEND "${OUT_HEADER}" "inline const char ${name}[] = {${bytes}0};\n")
endforeach()
file(APPEND "${OUT_HEADER}" "}\n")
